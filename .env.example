# ==============================================================================
# Splice Application Configuration
# ==============================================================================
PORT=3001
NODE_ENV=development
REA_MODE=mock
LLM_MODE=mock

# LLM API Keys (fill in for live model calls; defaults to mock for demo safety)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SPLICE_MODEL=claude-3-7-sonnet-20250219

# ==============================================================================
# Model Role Routing (Bedrock / OpenCode)
# models.json is the global default; per-role env vars below override it.
# Format for all models: OpenCode "provider/model"
# ==============================================================================
MODEL_DECOMP_WORKER=amazon-bedrock/amazon.nova-lite-v1:0
MODEL_SPEC_WRITER=amazon-bedrock/amazon.nova-pro-v1:0
MODEL_LEGAL_VERIFICATION=amazon-bedrock/anthropic.claude-opus-4-6-v1

# AWS Bedrock credentials (used by the orchestrator/worker)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Local OpenCode install mounted into orchestrator
OPENCODE_BIN=/home/mitch/.opencode/bin/opencode
OPENCODE_AUTH_FILE=/home/mitch/.local/share/opencode/auth.json
