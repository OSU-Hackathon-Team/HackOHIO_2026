# Copy to .env and edit. models.json is the global default; per-role env vars below override it.
# Format for all models: OpenCode "provider/model".
# OPENCODE_MODEL is the legacy override for the default role only.

# Role routing (override models.json without editing it):
# MODEL_DECOMP_WORKER=amazon-bedrock/amazon.nova-lite-v1:0   (or amazon-bedrock/qwen.qwen3-coder-480b-a35b-v1:0)
# MODEL_LEGAL_VERIFICATION=amazon-bedrock/anthropic.claude-opus-4-6-v1
# Splice roles (Claude only — see models.json role_notes):
# MODEL_SPEC_WRITER=amazon-bedrock/anthropic.claude-opus-5-5
# MODEL_ENGINE_WRITER=amazon-bedrock/anthropic.claude-opus-5-5
# MODEL_UI_SYNTHESIZER=amazon-bedrock/anthropic.claude-opus-5-5
# MODEL_REFUSAL_FALLBACK=amazon-bedrock/anthropic.claude-opus-4-8

# Legacy default override:
# OPENCODE_MODEL=amazon-bedrock/deepseek.v3.2

# AWS Bedrock credentials (used by the orchestrator/worker):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1
# AWS_DEFAULT_REGION=us-east-1

# Local OpenCode install mounted into the orchestrator:
# OPENCODE_BIN=/home/mitch/.opencode/bin/opencode
# OPENCODE_AUTH_FILE=/home/mitch/.local/share/opencode/auth.json
