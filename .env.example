# ==============================================================================
# Splice Application Configuration
# ==============================================================================
PORT=3001
NODE_ENV=development
REA_MODE=mock
LLM_MODE=mock

# Role routing (override models.json without editing it):
# MODEL_DECOMP_WORKER=amazon-bedrock/amazon.nova-lite-v1:0   (or amazon-bedrock/qwen.qwen3-coder-480b-a35b-v1:0)
# MODEL_LEGAL_VERIFICATION=amazon-bedrock/anthropic.claude-opus-4-6-v1
# Splice roles (Qwen via Converse — see models.json role_notes):
# MODEL_SPEC_WRITER=amazon-bedrock/qwen.qwen3-coder-480b-a35b-v1:0
# MODEL_ENGINE_WRITER=amazon-bedrock/qwen.qwen3-coder-480b-a35b-v1:0
# MODEL_UI_SYNTHESIZER=amazon-bedrock/qwen.qwen3-coder-480b-a35b-v1:0
# MODEL_REFUSAL_FALLBACK=amazon-bedrock/qwen.qwen3-coder-480b-a35b-v1:0

# ==============================================================================
# Model Role Routing (Bedrock / OpenCode)
# models.json is the global default; per-role env vars below override it.
# Format for all models: OpenCode "provider/model"
# ==============================================================================
MODEL_DECOMP_WORKER=amazon-bedrock/amazon.nova-lite-v1:0
MODEL_SPEC_WRITER=amazon-bedrock/qwen.qwen3-coder-480b-a35b-v1:0
MODEL_LEGAL_VERIFICATION=amazon-bedrock/anthropic.claude-opus-4-6-v1

# AWS Bedrock credentials (used by the orchestrator/worker)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Local OpenCode install mounted into orchestrator
OPENCODE_BIN=/home/mitch/.opencode/bin/opencode
OPENCODE_AUTH_FILE=/home/mitch/.local/share/opencode/auth.json
