{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DiscoverPrivateDecompCacheMisses",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::splice-lo-trial-1792893524936",
      "Condition": {"StringLike": {"s3:prefix": "cache/v1/*"}}
    },
    {
      "Sid": "PrivateDecompCache",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::splice-lo-trial-1792893524936/cache/v1/*"
    }
  ]
}
