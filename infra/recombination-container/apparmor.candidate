# Candidate profile for the Splice recombination runner on AppArmor hosts.
# Based on Moby's docker-default profile, with namespace/mount access needed by
# bubblewrap. This requires a separate security review before deployment.
abi <abi/5.0>,
include <tunables/global>
profile splice-recombination-container-candidate flags=(attach_disconnected,mediate_deleted) {
  allow network,
  allow unix,
  deny network ax25,
  deny network ipx,
  deny network appletalk,
  deny network netrom,
  deny network rose,
  deny network econet,
  deny network atmsvc,
  deny network irda,
  deny network wanpipe,
  deny network isdn,
  deny network caif,
  deny network alg,
  deny network vsock,
  allow capability,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow file,
  allow ix /**,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
}
