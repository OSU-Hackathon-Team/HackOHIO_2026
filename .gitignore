node_modules/
**/node_modules/

# Build outputs
dist/
**/dist/
.vite/
**/.vite/
*.tsbuildinfo
**/*.tsbuildinfo

# Downstream recombination runtime state
.splice-state/
.splice-state-*/

# Python / Agent artifacts
runs/
decomp-state
decomp-state/
.decomp-state
.decomp-state/
