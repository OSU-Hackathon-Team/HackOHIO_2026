!.agents/*.md
.codex/

# OS and Editor metadata
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Local scratch and one-off agent output
.tmp/
.temp/

