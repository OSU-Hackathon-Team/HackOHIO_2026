# Copy to packages/backend/.env (gitignored). Spec: agents/1_reverse_engineering/01_environment_and_rea_verification.md §5
PORT=3001
REA_MODE=auto              # live | replay | auto
LLM_MODE=live              # live | replay
REA_VERSION=6.7.0
REA_CALL_TIMEOUT_MS=60000
REA_RUN_BUDGET_MS=45000
REA_MAX_RESPONSE_BYTES=2000000
REA_DEBUG=0
# Models via Amazon Bedrock — credentials from the default AWS chain
AWS_REGION=us-east-2
AWS_PROFILE=splice         # or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN (never commit)
# Splice roles default to Qwen via Bedrock Converse. Claude overrides remain supported. Override a role without editing models.json:
# MODEL_SPEC_WRITER=amazon-bedrock/qwen.qwen3-coder-480b-a35b-v1:0
# MODEL_ENGINE_WRITER=amazon-bedrock/qwen.qwen3-coder-480b-a35b-v1:0
# MODEL_UI_SYNTHESIZER=amazon-bedrock/qwen.qwen3-coder-480b-a35b-v1:0
# MODEL_REFUSAL_FALLBACK=amazon-bedrock/qwen.qwen3-coder-480b-a35b-v1:0
LLM_DEBUG=0

# Private saved-analysis/building-block catalog. Falls back to DECOMP_EC2_BUCKET.
# Reads need s3:ListBucket and s3:GetObject; analysis/engine publication also needs s3:PutObject under library/*.
# DECOMP_LIBRARY_BUCKET=your-existing-private-bucket
