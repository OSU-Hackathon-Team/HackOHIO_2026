{
  "name": "@splice/backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && cp src/sandbox/worker.cjs dist/sandbox/worker.cjs",
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "rea:catalog": "tsx src/scripts/reaCatalog.ts",
    "seed:evidence": "tsx src/scripts/makeSeedEvidence.ts",
    "record:evidence": "tsx src/scripts/recordAll.ts",
    "fixtures:promote": "tsx src/scripts/promoteFixtures.ts",
    "test:bridge": "tsx src/scripts/testBridge.ts",
    "test:collector": "tsx src/scripts/testCollector.ts",
    "test:llm": "tsx src/scripts/testLlm.ts",
    "test:sandbox": "tsx src/scripts/testSandbox.ts",
    "test:spec": "tsx src/scripts/testSpec.ts",
    "spec:all": "tsx src/scripts/specAll.ts",
    "test:implement": "tsx src/scripts/testImplement.ts",
    "test:synthesis": "tsx src/scripts/testSynthesis.ts",
    "test:replay": "tsx src/scripts/testReplayPipeline.ts",
    "test:unit": "node --import tsx --test --test-force-exit \"src/**/*.test.ts\"",
    "seed:studio": "tsx src/scripts/seedStudio.ts",
    "pretest": "npm run build --workspace=@splice/contracts",
    "test": "npm run build && node --test --test-force-exit \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^1.1.0",
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1156.0",
    "@aws-sdk/client-ec2": "^3.1156.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/client-ssm": "^3.1156.0",
    "@electron/asar": "3.2.17",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@splice/contracts": "*",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "typescript": "^5.7.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/canvas-confetti": "1.9.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.19",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "lucide-react": "0.344.0",
    "tsx": "^4.19.2"
  },
  "type": "module"
}
